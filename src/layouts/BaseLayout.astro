---
import '../styles/global.css'; // Ensure import filename matches global_2.css
import WhatsAppButton from '../components/WhatsAppFloat.astro';
import WebFormFloat from '../components/WebFormFloat.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Heatherlea Holiday Cottage | Otterburn, Northumberland", 
  description = "Book Your Stay in Otterburn, Northumberland",
  image = "/heatherlea-favicon.ico"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/heatherlea-favicon.svg" />
    <link rel="icon" href="/heatherlea-favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/heatherlea-favicon.png" />

</head>

<body>
    
<a href="#main-content" class="skip-link">Skip to main content</a>

<main class="main" id="main-content">

  <slot />

</main>

<footer class="footer">
  <hr class="divider-full" />
  
  <p>Heatherlea Holiday Cottage</p>
  <p>&copy; {new Date().getFullYear()} Heatherlea Holiday Cottage. All rights reserved.</p>

  <nav class="footer-nav" aria-label="Legal navigation">
    <a href="/privacy">Privacy Policy</a>
    <a href="/cookies">Cookie Policy</a>
    <a href="/accessibility">Accessibility Statement</a>
  </nav>

  <WebFormFloat />

  <WhatsAppButton phoneNumber="+447713651215" message="Hello. I'd like to inquire about booking a stay at Heatherlea Holiday Cottage." />

</footer>

</body>

</html>