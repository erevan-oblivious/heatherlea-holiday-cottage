---
interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
}

const {
  title = "Check Availability & Enquire",
  description = "Please fill out the form below to check dates, ask a question, or plan your stay at Heatherlea Holiday Cottage.",
  eyebrow = "Get in Touch",
} = Astro.props;
---

<section class="form-section" id="contact-form">
  <div class="form-container">
    
    <div class="section-header">
      {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
      <h2 class="section-title">{title}</h2>
      <p class="section-description">{description}</p>
    </div>

    <form class="template-form" action="/api/form" method="POST">
      <!-- Anti-Spam Honeypot Field (Hidden) -->
      <input type="text" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />

      <!-- SECTION 1: CONTACT INFORMATION -->
      <fieldset class="form-fieldset">
        <legend class="fieldset-title">Your Contact Information</legend>
        
        <div class="form-row two-col">
          <div class="form-group">
            <label for="first-name">First Name <span class="required">*</span></label>
            <input type="text" id="first-name" name="firstName" required autocomplete="given-name" placeholder="e.g. Sarah" />
          </div>
          <div class="form-group">
            <label for="last-name">Last Name <span class="required">*</span></label>
            <input type="text" id="last-name" name="lastName" required autocomplete="family-name" placeholder="e.g. Jenkins" />
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label for="email">Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="e.g. sarah@example.com" />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number <span class="required">*</span></label>
            <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="e.g. 07123 456789" />
          </div>
        </div>
      </fieldset>

      <!-- SECTION 2: STAY PREFERENCES -->
      <fieldset class="form-fieldset">
        <legend class="fieldset-title">Stay Details</legend>
        
        <div class="form-row two-col">
          <div class="form-group">
            <label for="check-in">Preferred Check-in Date <span class="optional">(Optional)</span></label>
            <input type="date" id="check-in" name="checkInDate" />
          </div>
          <div class="form-group">
            <label for="check-out">Preferred Check-out Date <span class="optional">(Optional)</span></label>
            <input type="date" id="check-out" name="checkOutDate" />
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label for="guests">Number of Guests <span class="required">*</span></label>
            <select id="guests" name="guests" required>
              <option value="">Select guests...</option>
              <option value="1-2 Guests">1 - 2 Guests</option>
              <option value="3-4 Guests">3 - 4 Guests</option>
              <option value="5-6 Guests">5 - 6 Guests (Max 6)</option>
            </select>
          </div>
        </div>
      </fieldset>

      <!-- SECTION 3: ENQUIRY DETAILS -->
      <fieldset class="form-fieldset">
        <legend class="fieldset-title">Enquiry Purpose</legend>

        <div class="form-group">
          <label for="message">Your Message or Special Requirements <span class="required">*</span></label>
          <textarea id="message" name="message" rows="4" required placeholder="Please let us know your preferred dates, questions about the cottage, or any special requests..."></textarea>
        </div>
      </fieldset>

      <!-- SECTION 4: CONSENT & SUBMIT -->
      <fieldset class="form-fieldset consent-fieldset">
        <div class="checkbox-group">
          <input type="checkbox" id="terms-consent" name="termsConsent" required />
          <label for="terms-consent">
            I consent to being contacted regarding this stay or enquiry. <span class="required">*</span>
          </label>
        </div>

        <div class="form-submit">
          <button type="submit" class="btn btn-primary btn-submit">
            <span>Send Enquiry</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </fieldset>

    </form>

  </div>
</section>

<style>
  .form-section {
    padding: 4.5rem 1.5rem;
    background-color: var(--background);
  }

  .form-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .template-form {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    padding: 2.5rem 2rem;
  }

  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
  }

  .form-fieldset:last-of-type {
    margin-bottom: 0;
  }

  .fieldset-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .form-row {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .form-row.two-col {
    grid-template-columns: repeat(2, 1fr);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .form-row .form-group {
    margin-bottom: 0;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .required {
    color: var(--secondary);
  }

  .optional {
    font-weight: 400;
    color: var(--secondary);
    font-size: 0.8125rem;
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  input[type="date"],
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm, 6px);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  select option {
    background-color: var(--background);
    color: var(--text-primary);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--secondary);
    box-shadow: 0 0 0 2px rgba(163, 184, 163, 0.25);
  }

  textarea {
    resize: vertical;
    min-height: 90px;
  }

  .consent-fieldset {
    background-color: rgba(0, 0, 0, 0.15);
    padding: 1.5rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--border-subtle);
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .checkbox-group input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--secondary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-group label {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-primary);
    cursor: pointer;
    margin-bottom: 0;
  }

  .form-submit {
    margin-top: 1.5rem;
  }

  .btn-submit {
    max-width: 100%;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .form-section {
      padding: 3rem 1rem;
    }

    .template-form {
      padding: 1.5rem 1.25rem;
    }

    .form-row.two-col {
      grid-template-columns: 1fr;
    }
  }
</style>