---
import { Image } from 'astro:assets';
import mapPreview from '../images/google-maps-screenshot.png'; // Screenshot of map pinned on Heatherlea
---

<section class="location-section">
  <div class="location-container">

    <div class="map-preview-wrapper">
      <a href="https://maps.app.goo.gl/pAtn62EytfGniBRz9" target="_blank" rel="noopener noreferrer">
        <Image 
          src={mapPreview} 
          alt="Map showing Heatherlea Holiday Cottage in Otterburn" 
          width={600} 
          height={400} 
          class="map-image"
        />
        <span class="map-overlay-badge">Click to open directions</span>
      </a>
    </div>
  </div>
</section>

<style>
  .map-preview-wrapper {
    position: relative;
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    max-width: var(--max-width-wide);
  }

  .map-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .map-preview-wrapper:hover .map-image {
    transform: scale(1.03);
  }

  .map-overlay-badge {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    pointer-events: none;
  }
</style>