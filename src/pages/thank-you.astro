---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Thank You | Heatherlea Holiday Cottage"
  description="Thank you for your enquiry or booking request at Heatherlea Holiday Cottage."
  >

    <section class="prose-container">

        <header class="section-header">
          <span class="section-eyebrow">Enquiry Received</span>
          <h1>Thank You</h1>
        </header>

        <div>
          <p>We have  received your message and will get back to you shortly.</p>
          <a href="/" class="btn btn-primary">Return to Homepage</a>
        </div>

    </section>

</BaseLayout>