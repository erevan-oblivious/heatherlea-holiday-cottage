---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import GoogleMaps from '../components/GoogleMaps.astro';
import CardColumn from '../components/CardColumn.astro';
import WebForm from '../components/WebForm.astro';

import room1 from '../images/outside-1.jpg';
import room2 from '../images/master-room-1.jpg';
import room3 from '../images/double-room-1.jpg';
import room4 from '../images/twin-room-2.jpg';
import room5 from '../images/single-room-1.jpg';
import room6 from '../images/living-room-1.jpg';
import room7 from '../images/sun-room-1.jpg';
import room8 from '../images/kitchen-1.jpg';
import room9 from '../images/bathroom-1.jpg';
import room10 from '../images/garden-1.jpg';
import room11 from '../images/outside-2.jpg';
import room12 from '../images/en-suite-1.jpg';

const galleryImages = [
  { src: room1, alt: "Outside the front of Heatherlea Cottage" },
  { src: room2, alt: "The Master Bedroom" },
  { src: room3, alt: "The Groundfloor Double Room" },
  { src: room4, alt: "The Twin Room" },
  { src: room5, alt: "The Single Room" },
  { src: room6, alt: "The Living Room" },
  { src: room7, alt: "The Sun Room" },
  { src: room8, alt: "The Kitchen" },
  { src: room9, alt: "The Main Bathroom" },
  { src: room10, alt: "The Enclosed Back Garden" },
  { src: room11, alt: "The Front Garden" },
  { src: room12, alt: "The En-Suite Bathroom" }
];

---

<BaseLayout 
  title="Welcome | Heatherlea Holiday Cottage"
  description="Book Your Stay in Otterburn, Northumberland"
>

<section>

  <HeroImage 
  title = "Heatherlea Holiday Cottage",
  lead = "Welcome to our beautiful holiday cottage in Otterburn, Northumberland. Perfect for weddings and journeys in Northumberland.",
  description = "Detached holiday cottage with four bedrooms, two living rooms, kitchen, drive, and enclosed back garden. Pets welcome. Sleeps seven.",
  bgImage = "/double-room-1.jpg",
  bgImageMobile = "/double-room-1.jpg",
  primaryButtonText = "Book Now",
  primaryButtonLink,
  tintOpacity = "40%",
  
  />

</section>

<section>

  <header class="section-header">
    <span class="section-eyebrow">Photo Gallery</span>
    <h2>Take a look around</h2>
  </header>

  <MasonryGallery images={galleryImages} />

</section>

<section>

  <header class="section-header">
    <span class="section-eyebrow">Location</span>
    <h2>Where to Find Us</h2>
  </header>

  <div class="prose-container">
    <p>Nestled in the historic village of Otterburn, Heatherlea is perfectly placed for exploring the breathtaking Northumberland National Park, Kielder Water, and local wedding venues.</p>
    <p>Heatherlea, Otterburn, Northumberland, NE19 1NT</p>
    <a href="https://maps.app.goo.gl/pAtn62EytfGniBRz9" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      View on Google Maps
    </a>
  </div>

  <GoogleMaps />

</section>

<section>

  <CardColumn />

</section>

<section class="review-section">

  <header class="section-header">
    <span class="section-eyebrow">Reviews</span>
    <h2>What Our Guests Say</h2>
  </header>

  <div class="review-container">

    <script defer async src='https://cdn.trustindex.io/loader.js?4d46a638310151524b06a69ccc6'></script>

  </div>

</section>

<section>

<WebForm />

</section>

</BaseLayout>